# Supabase Connect panel: PostgreSQL URI, preferably session pooler (port 5432).
SUPABASE_DB_URL=

# Strava Sync Archive
STRAVA_SYNC_ARCHIVE=

# MCP Host URL Details 
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Render supplies PORT automatically; it takes precedence over MCP_PORT.
MCP_PUBLIC_URL=

# MCP Path Secret for Connecting with ChatGPT or Claude 
MCP_PATH_SECRET=

# Optional Drive source (share folder with the service account's email):
DRIVE_FOLDER_ID=

# Google Service Account Details  
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional local/self-hosted scheduler only; production uses GitHub Actions:
# Daily time in this IANA timezone (24-hour HH:MM):
DRIVE_INGEST_TIME=06:00
DRIVE_INGEST_TIMEZONE=Asia/Kolkata
# Maximum runtime of each scheduled ingestion (positive seconds):
DRIVE_INGEST_TIMEOUT_S=1800
