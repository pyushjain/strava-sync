# Daily scheduled Drive ingestion, in this IANA timezone (24-hour HH:MM):
DRIVE_INGEST_TIME=06:00
DRIVE_INGEST_TIMEZONE=Asia/Kolkata
# Maximum runtime of each scheduled ingestion (positive seconds):
DRIVE_INGEST_TIMEOUT_S=1800
